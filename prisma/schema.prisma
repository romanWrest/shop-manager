generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  MANAGER
  ROOT
}

enum TerminalStatus {
  ACTIVE
  INACTIVE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Admin {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  role      AdminRole @default(MANAGER)
  token     String?   @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("admins")
}

model ShopOwner {
  id        String   @id @default(uuid())
  name      String
  phone     String
  email     String?
  address   String?
  inn       String?
  shops     Shop[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("shop_owners")
}

model Shop {
  id          String     @id @default(uuid())
  name        String
  address     String
  inn         String
  kpp         String?
  ogrn        String?
  login       String     @unique
  password    String
  ownerId     String
  owner       ShopOwner  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  terminals   Terminal[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("shops")
}

model Terminal {
  id        String         @id @default(uuid())
  macAddress String        @unique
  status    TerminalStatus @default(INACTIVE)
  shopId    String?
  shop      Shop?          @relation(fields: [shopId], references: [id], onDelete: SetNull)
  requests  Request[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("terminals")
}

model Request {
  id         String        @id @default(uuid())
  terminalId String
  terminal   Terminal      @relation(fields: [terminalId], references: [id], onDelete: Cascade)
  shopLogin  String
  status     RequestStatus @default(PENDING)
  comment    String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@map("requests")
}
